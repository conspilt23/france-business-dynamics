# Configuration SQL Server locale — copier vers .env (jamais committé).
# Connexion Windows (authentification intégrée) :
SQL_SERVER=localhost
SQL_DATABASE=FranceBusinessDynamics
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
# Connexion SQL (si SQL_TRUSTED_CONNECTION=no) — ne jamais committer de vrais identifiants :
# SQL_USER=
# SQL_PASSWORD=

# Optionnel : relocaliser les données hors du dépôt (disque externe, etc.)
# FBD_DATA_DIR=D:/fbd-data
